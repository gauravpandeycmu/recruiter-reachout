# Copy to `.env` in the repo root (never commit `.env`).
# Local `.env` is gitignored. GitHub should never contain real keys.

# --- Required for email drafts (Gemini) ---
GEMINI_API_KEY=
# Optional override; default is gemma-4-31b-it
# GEMINI_MODEL=gemma-4-31b-it

# --- Required for Jobright email lookup ---
# Any Jobright job-posting page you can open while logged in, e.g.
# https://jobright.ai/jobs/info/<id>
JOBRIGHT_JOB_URL=
JOBRIGHT_DRY_RUN=false

# --- Required for real Gmail sends via Playwright + Streak ---
JOBRIGHT_HEADLESS=true
SALESQL_HEADLESS=true
GMAIL_HEADLESS=false
WORKER_AUTO_SEND=false
SALESQL_DRY_RUN=false
APOLLO_DRY_RUN=false

# Chrome Web Store extensions installed in Google Chrome (macOS default path is auto-detected).
# Set these only if Chrome installed them somewhere else.
# SALESQL_EXTENSION_PATH=
# APOLLO_EXTENSION_PATH=
# STREAK_EXTENSION_PATH=

# --- Strongly recommended before any real recruiter mail ---
TEST_MODE=true
TEST_MODE_RECIPIENT_EMAIL=you@example.com

# --- Optional email-finder APIs (used after Jobright / SalesQL / Apollo) ---
# HUNTER_API_KEY=
# GETPROSPECT_API_KEY=
# PROSPEO_API_KEY=
# KWINBI_API_KEY=

# --- Optional Gmail OAuth (browser login in Setup is enough for Playwright sends) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/gmail/callback
# TOKEN_ENCRYPTION_KEY=

# --- Optional public tracking relay (HTTPS required for real tracked sends) ---
# PUBLIC_TRACKING_BASE_URL=https://your-relay.example.workers.dev
# RELAY_SYNC_TOKEN=

# --- Caps (defaults are already conservative) ---
# DAILY_INTAKE_LIMIT=300
# DAILY_SEND_LIMIT=200
# HOURLY_SEND_LIMIT=100
# DOMAIN_DAILY_SEND_LIMIT=100
