{
  "name": "@recruiter/worker",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "discover:one": "tsx scripts/discover-one.ts",
    "explore:salesql": "tsx scripts/explore-salesql.ts",
    "probe:salesql": "tsx scripts/probe-salesql.ts",
    "diagnose:salesql": "tsx scripts/diagnose-salesql.ts",
    "inspect:salesql": "tsx scripts/inspect-salesql-dom.ts",
    "watch:salesql": "tsx scripts/watch-salesql.ts",
    "migrate:salesql-profile": "tsx scripts/migrate-salesql-profile.ts",
    "open:login": "tsx scripts/open-login.ts",
    "probe:sessions": "tsx scripts/probe-sessions.ts",
    "smoke:gmail": "tsx scripts/smoke-gmail.ts",
    "e2e:test-mode-send": "tsx scripts/e2e-test-mode-send.ts",
    "prove:gmail-compose": "tsx scripts/prove-gmail-compose.ts",
    "install:streak": "tsx scripts/install-streak.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:live": "LIVE_PLAYWRIGHT=1 JOBRIGHT_DRY_RUN=false vitest run test/live --sequence.concurrent=false",
    "test:live:jobright": "LIVE_PLAYWRIGHT=1 JOBRIGHT_DRY_RUN=false vitest run test/live/jobrightFindEmail",
    "test:live:gmail": "LIVE_PLAYWRIGHT=1 vitest run test/live/gmailTestModeSend"
  },
  "dependencies": {
    "@recruiter/shared": "2.0.0",
    "playwright": "latest",
    "tsx": "latest"
  }
}
